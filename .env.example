# ── Eval configuration ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit it.

# Anthropic API key (required to run evals)
ANTHROPIC_API_KEY=sk-ant-...

# Model used for both skill invocation (candidate) and llm-rubric grading.
# Use the full promptfoo provider string: provider:model-id
# Examples:
#   anthropic:claude-3-7-sonnet-20250219   (default)
#   anthropic:claude-opus-4-5
#   openai:gpt-4o
EVAL_MODEL=anthropic:claude-3-7-sonnet-20250219
