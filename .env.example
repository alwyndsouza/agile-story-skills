# ── Eval configuration ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit it.

# Anthropic API key (required to run evals)
ANTHROPIC_API_KEY=

# LLM provider for skill invocation (candidate) and llm-rubric grading.
# Examples: anthropic | openai | google
EVAL_PROVIDER=anthropic

# Model name within that provider.
# Examples:
#   claude-3-7-sonnet-20250219   (Anthropic default)
#   claude-opus-4-5
#   gpt-4o                       (OpenAI)
EVAL_MODEL=claude-3-7-sonnet-20250219
